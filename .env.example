# ---------------------------------------------------------------------------
# Nova Assist — variables d'environnement
#
# Copier ce fichier en `.env.local` et y coller les vraies valeurs.
# `.env.local` est ignoré par Git ; ce fichier-ci ne doit contenir QUE des
# valeurs factices, il est versionné pour documenter les noms attendus.
# ---------------------------------------------------------------------------

# --- Supabase ---------------------------------------------------------------
# Tableau de bord Supabase → Project Settings → API

# Publiques : exposées au navigateur, protégées par les politiques RLS.
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=collez-ici-la-cle-anon

# SECRÈTE : contourne toutes les règles RLS.
# Uniquement côté serveur (routes API, actions). Jamais dans un composant
# client, jamais préfixée NEXT_PUBLIC_, jamais commitée.
SUPABASE_SERVICE_ROLE_KEY=collez-ici-la-cle-service-role

# --- À venir ----------------------------------------------------------------
# Transport email pour les demandes de devis (cahier des charges §6.1)
# RESEND_API_KEY=

# Paiement Tara (§6.2) — sous réserve de validation avec la cliente
# TARA_API_KEY=
# TARA_MERCHANT_ID=
